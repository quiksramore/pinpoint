{
  "name": "@pinpoint/api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc && tsc-alias",
    "typecheck": "tsc --noEmit",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile api",
    "dev": "bun run --env-file=.env --watch src/index.ts",
    "start": "bun run --env-file=.env src/index.ts",
    "lint": "biome check .",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/electron": "^1.6.9",
    "@better-auth/expo": "^1.6.9",
    "@elysiajs/cors": "^1.4.2",
    "@orpc/experimental-publisher": "^1.14.0",
    "@orpc/openapi": "^1.14.0",
    "@orpc/server": "^1.14.0",
    "@pinpoint/contracts": "workspace:*",
    "@sinclair/typebox": "^0.34.49",
    "@types/heic-convert": "^2.1.0",
    "better-auth": "^1.6.9",
    "dotenv": "^17.4.2",
    "elysia": "^1.4.28",
    "exifreader": "^4.38.1",
    "exiftool-vendored": "^35.19.0",
    "file-type": "^22.0.1",
    "heic-convert": "^2.1.0",
    "mongoose": "^8.23.1",
    "mongoose-zod": "https://github.com/ShreyasAyyengar/mongoose-zod",
    "node": "^24.15.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "uuid": "^14.0.0"
  },
  "exports": {
    "./auth-server": "./src/libs/auth-server.ts"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "tsc-alias": "^1.8.16"
  }
}
